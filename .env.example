# ---- Artifactory (source) ----
# JFrog Cloud:      https://<org>.jfrog.io/artifactory/<repo>/
# Self-hosted:      https://host/artifactory/<repo>/
# A sub-path works too (serves only that folder).
ART_URL=https://yourorg.jfrog.io/artifactory/my-generic-repo/

# Preferred: an access token (sent as "Authorization: Bearer ...").
ART_TOKEN=
# Or username + password / API key (sent as Basic auth). Leave blank for anonymous.
ART_USER=
ART_PASSWORD=

# ---- SMB (what clients see) ----
SMB_USER=artuser
SMB_PASSWORD=change-me
SMB_SHARE=artifacts
SMB_WORKGROUP=WORKGROUP
# true = no password required (LAN only!). SMB_PASSWORD may then be empty.
SMB_GUEST=false
# Host port. Use e.g. 4445 if the host already runs Samba (Windows clients need 445).
SMB_PORT=445

# ---- Read behaviour / tuning ----
# full    = cache only the ranges that were read (best for random access)
# off     = pure pass-through, nothing stored; seeks reopen the stream
CACHE_MODE=full
CACHE_MAX_SIZE=20G
CACHE_MAX_AGE=24h
CACHE_DIR=./cache
READ_CHUNK_SIZE=16M
READ_CHUNK_LIMIT=256M
READ_AHEAD=64M
# How long folder listings are remembered (new uploads appear after this).
DIR_CACHE_TIME=10m
RCLONE_LOG_LEVEL=NOTICE
# Extra rclone mount flags, e.g. "--transfers 8 --http-no-slash"
RCLONE_EXTRA_ARGS=
